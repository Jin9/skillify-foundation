{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage4_gherkin",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "stage_status"],
  "properties": {
    "stage": { "const": "gherkin" },
    "stage_status": { "enum": ["complete", "blocked"] },
    "failure_code": { "type": "string" },
    "failure_reason": { "type": "string" },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/definitions/story" }
    },
    "gherkin_quality_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "blocker"] },
          "story_id": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "processing_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ac_generation"],
      "properties": {
        "ac_generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stories_processed", "idempotency_scenarios_added", "audit_scenarios_added"],
          "properties": {
            "stories_processed": { "type": "integer", "minimum": 0 },
            "idempotency_scenarios_added": { "type": "integer", "minimum": 0 },
            "audit_scenarios_added": { "type": "integer", "minimum": 0 },
            "tipping_off_scenarios_added": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage_status": { "const": "complete" } }, "required": ["stage_status"] },
      "then": { "required": ["stories", "gherkin_quality_findings", "processing_metadata"] }
    },
    {
      "if": { "properties": { "stage_status": { "const": "blocked" } }, "required": ["stage_status"] },
      "then": { "required": ["failure_code", "failure_reason"] }
    }
  ],
  "definitions": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "acceptance_criteria", "banking_grade_concerns"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 8 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/acceptanceCriterion" }
        },
        "banking_grade_concerns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pii_fields",
            "audit_events",
            "idempotency",
            "reversibility",
            "authn_authz",
            "regulatory",
            "tipping_off"
          ],
          "properties": {
            "pii_fields": { "$ref": "#/definitions/bankingGradeRow" },
            "audit_events": { "$ref": "#/definitions/bankingGradeRow" },
            "idempotency": { "$ref": "#/definitions/bankingGradeRow" },
            "reversibility": { "$ref": "#/definitions/bankingGradeRow" },
            "authn_authz": { "$ref": "#/definitions/bankingGradeRow" },
            "regulatory": { "$ref": "#/definitions/bankingGradeRow" },
            "tipping_off": { "$ref": "#/definitions/bankingGradeRow" }
          }
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_name", "scenario_type", "given", "when", "then"],
      "properties": {
        "scenario_name": { "type": "string", "minLength": 8 },
        "scenario_type": {
          "enum": [
            "happy",
            "error",
            "banking_grade_audit",
            "banking_grade_idempotency",
            "banking_grade_tipping_off",
            "banking_grade_reversibility",
            "banking_grade_notification",
            "banking_grade_authz",
            "edge_case"
          ]
        },
        "given": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "when": { "type": "string", "minLength": 8 },
        "then": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bankingGradeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "justification"],
      "properties": {
        "status": { "enum": ["applies", "not_applicable", "unknown_p2"] },
        "justification": { "type": "string", "minLength": 10 },
        "fields_or_events": { "type": "array", "items": { "type": "string" } },
        "treatment": { "type": "string" },
        "compensating_action": { "type": "string" }
      }
    }
  }
}
