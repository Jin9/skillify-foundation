{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage3_ambiguity",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "stage_status"],
  "properties": {
    "stage": { "const": "ambiguity" },
    "stage_status": { "enum": ["complete", "blocked"] },
    "failure_code": { "type": "string" },
    "failure_reason": { "type": "string" },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "#/definitions/openQuestion" }
    },
    "assumptions_made": {
      "type": "array",
      "items": { "$ref": "#/definitions/assumption" }
    },
    "ambiguity_findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/ambiguityFinding" }
    },
    "processing_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hidden_requirements_sweep"],
      "properties": {
        "hidden_requirements_sweep": { "$ref": "#/definitions/hiddenSweep" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage_status": { "const": "complete" } }, "required": ["stage_status"] },
      "then": { "required": ["open_questions", "assumptions_made", "ambiguity_findings", "processing_metadata"] }
    },
    {
      "if": { "properties": { "stage_status": { "const": "blocked" } }, "required": ["stage_status"] },
      "then": { "required": ["failure_code", "failure_reason"] }
    }
  ],
  "definitions": {
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "question", "why_matters", "suggested_resolver", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^OQ-[0-9]+$" },
        "severity": { "enum": ["P1", "P2", "P3"] },
        "question": { "type": "string", "minLength": 12 },
        "why_matters": { "type": "string", "minLength": 20 },
        "suggested_resolver": { "type": "string" },
        "related_story_ids": { "type": "array", "items": { "type": "string" } },
        "provenance": { "enum": ["prose_ambiguity", "hidden_frame_sweep"] },
        "frame": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption", "why_made"],
      "properties": {
        "assumption": { "type": "string", "minLength": 10 },
        "why_made": { "type": "string", "minLength": 10 },
        "related_story_ids": { "type": "array", "items": { "type": "string" } },
        "provenance": { "enum": ["prose_inference", "hidden_frame_sweep"] },
        "frame": { "type": "integer", "minimum": 1, "maximum": 10 },
        "default_revisit_trigger": { "type": "string", "minLength": 8 }
      }
    },
    "ambiguityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "severity", "evidence", "resolution_path"],
      "properties": {
        "detector": {
          "enum": [
            "lexical",
            "syntactic",
            "pragmatic",
            "pronominal",
            "quantifier",
            "modal",
            "commitment_conditionality",
            "phase_boundary_drift",
            "placeholder"
          ]
        },
        "severity": { "enum": ["P1", "P2", "P3"] },
        "evidence": { "type": "string", "minLength": 3 },
        "source_ref": { "type": "string" },
        "resolution_path": { "type": "string", "minLength": 8 },
        "related_question_id": { "type": "string" }
      }
    },
    "hiddenSweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames_applied", "findings_per_frame", "total_findings", "coverage_score"],
      "properties": {
        "frames_applied": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 10 },
          "uniqueItems": true
        },
        "frames_skipped": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 10 },
          "uniqueItems": true
        },
        "frames_skipped_reasons": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 8 }
        },
        "findings_per_frame": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "deferred_findings_count": { "type": "integer", "minimum": 0 },
        "total_findings": { "type": "integer", "minimum": 0 },
        "coverage_score": { "enum": ["complete", "partial", "skipped"] }
      }
    }
  }
}
