# Backend service URLs — server-only (no NEXT_PUBLIC_ prefix; never exposed to browser JS)
BACKEND_IDENTITY_URL=http://identity:8080
BACKEND_CATALOG_URL=http://catalog:8080
BACKEND_CART_URL=http://cart:8080
BACKEND_CHECKOUT_URL=http://checkout:8080
BACKEND_ORDER_URL=http://order:8080
BACKEND_PAYMENT_URL=http://payment:8080
BACKEND_INVENTORY_URL=http://inventory:8080

# Public app name (safe to expose — only string used client-side)
NEXT_PUBLIC_APP_NAME=ShopPilot

# Node environment
NODE_ENV=development

# INTERNAL_SHARED_SECRET — not used by frontend (backend-to-backend only); omitted intentionally.
# If added in future, it must NOT carry a NEXT_PUBLIC_ prefix.
