# GENERATED by core/policy/generate.py from core/policy/policy.json — DO NOT EDIT BY HAND.
# Deterministic projection of the canonical command-safety policy. Evaluation
# order is deny -> confirm -> allow -> default; deny wins. Regenerate after any
# policy.json change. Exact Codex execpolicy syntax may need a per-version adapter.
# default = ask

[deny]
rule git-add-all: match=/\bgit\s+add\s+(-A\b|--all\b|\.|:/|\*)/i action=deny  # Stage explicit paths only; never `git add .` / -A / --all.
rule stage-secrets: match=/\bgit\s+add\b.*(\.env|secret|id_rsa|\.pem\b|credential|\.npmrc|\.aws)/i action=deny  # Refusing to stage secrets / .env / keys.
rule stage-cicd-prod: match=/\bgit\s+add\b.*(\.github/workflows|\.gitlab-ci|/deploy/|/prod/|/production/)/i action=deny  # Refusing to stage CI/CD or prod config.
rule git-commit-amend: match=/\bgit\s+commit\b.*--amend/i action=deny  # Never --amend in this workflow.
rule git-commit-coauthor: match=/(?i)co-authored-by/i action=deny  # Never add a Co-Authored-By trailer; use Assisted-by.
rule git-push-force: match=/\bgit\s+push\b.*(--force\b|--force-with-lease\b|\s-f\b|\s\+[\w/]+:)/i action=deny  # Force-push is forbidden.
rule git-push-delete: match=/\bgit\s+push\b.*(--delete\b|\s:[\w/]+)/i action=deny  # Never delete a remote branch.
rule rm-recursive-force: match=/\brm\s+(-\w*r\w*f|-\w*f\w*r|-r\s+-f|-f\s+-r)\w*/i action=deny  # Recursive force delete is forbidden.
rule remote-exec: match=/(curl|wget)\b[^|]*\|\s*(sudo\s+)?(sh|bash|zsh|python\d?)/i action=deny  # No piping remote content into a shell/interpreter.
rule mr-merge-approve: match=/\b(glab\s+mr\s+(merge|approve|close)|gh\s+pr\s+(merge|close))\b/i action=deny  # Never merge / approve / close the MR or PR.
rule jira-transition: match=/\b(transition|transitionJiraIssue|editJiraIssue)\b/i action=deny  # Never transition or edit the Jira issue from the shell.

[confirm]
rule git-commit: match=/\bgit\s+commit\b/i action=confirm  # Committing is a gated step (Gate 2/3) — requires named approval.
rule git-push: match=/\bgit\s+push\b/i action=confirm  # Pushing is a Gate-3 outward action — requires named approval.
rule mr-create: match=/\b(glab\s+mr\s+create|gh\s+pr\s+create)\b/i action=confirm  # Opening the MR/PR is a Gate-3 action — requires named approval.
rule git-checkout-branch: match=/\bgit\s+(checkout\s+-b|switch\s+-c|branch)\b/i action=confirm  # Branch creation should follow the fix/{KEY}-{slug} convention; confirm name.

[allow]
rule git-read: match=/\bgit\s+(status|diff|log|show|branch\s+--show-current|rev-parse|remote\s+-v|ls-files|fetch)\b/i action=allow
rule git-add-explicit: match=/\bgit\s+add\s+(?!-A\b|--all\b|\.|:/|\*)[\w./@-]+/i action=allow
rule test-pytest: match=/python\d?\s+-m\s+pytest\b/i action=allow
rule test-npm: match=/\bnpm\s+(test|run\s+test)\b/i action=allow
rule test-go: match=/\bgo\s+test\b/i action=allow
rule test-cargo: match=/\bcargo\s+test\b/i action=allow
rule read-only: match=/^\s*(ls|cat|head|tail|grep|rg|find|pwd|echo|wc|sort|uniq|diff)\b/i action=allow
